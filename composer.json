{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "bagart/telegram-bot-lib-basic",
    "description": "Telegram Bot basic commands library",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "ASK",
        "async",
        "pipeline",
        "client",
        "execution-engine",
        "fiber",
        "transport",
        "runtime",
        "future"
    ],
    "authors": [
        {
            "name": "BAGArt (Artur Baltaev)",
            "email": "baltaev.artur+ask@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "bagart/telegram-bot-lib": "*"
    },
    "autoload": {
        "psr-4": {
            "BAGArt\\TelegramBotBasic\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BAGArt\\TelegramBotBasic\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "composer exec pest tests --colors=always"
    },
    "repositories": {
        "telegram-bot-lib": {
            "type": "path",
            "url": "../telegram-bot-lib"
        },
        "php-async-kernel-lib": {
            "type": "path",
            "url": "../php-async-kernel-lib"
        },
        "php-async-kernel-client": {
            "type": "path",
            "url": "../php-async-kernel-client"
        },
        "baseline": {
            "type": "path",
            "url": "../telegram-platform-devops-baseline"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "bagart/telegram-platform-devops-baseline": "@dev"
    }
}
